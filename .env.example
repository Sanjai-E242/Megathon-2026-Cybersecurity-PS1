# Sentinel Runtime Configuration

# Server Port
PORT=3001

# Supabase Persistence & Realtime (Optional - Local fallback will operate if not provided)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Frontend Supabase Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# External Agent Authentication Key
SENTINEL_AGENT_API_KEY=sentinel_sec_live_key_demo_99

# GitHub External Integration (Optional - Safe Demo Fallback operates if token is omitted)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_DEMO_OWNER=Sanjai-E242
GITHUB_DEMO_REPO=sentinel-runtime

