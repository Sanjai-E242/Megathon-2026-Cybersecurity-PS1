# Sentinel Runtime Configuration

# Server Port (Render / Hosting will assign automatically via PORT)
PORT=3001

# Backend CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=https://sentinel-runtime.vercel.app,http://localhost:5173

# Frontend API Base URL (Set in Vercel to your deployed Render backend)
# Local: leave empty (defaults to /api proxy) or set to http://localhost:3001
# Production: https://your-sentinel-backend.onrender.com
VITE_API_BASE_URL=http://localhost:3001

# Supabase Persistence & Realtime (Optional - Local in-memory fallback will operate if not provided)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Frontend Supabase Environment Variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# External Agent Authentication Key
SENTINEL_AGENT_API_KEY=sentinel_sec_live_key_demo_99

# External Agent Backend URL (For Python and TypeScript external agents)
SENTINEL_API_URL=http://localhost:3001

# GitHub External Integration (Optional - Safe Demo Fallback operates if token is omitted)
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_DEMO_OWNER=Sanjai-E242
GITHUB_DEMO_REPO=sentinel-runtime
